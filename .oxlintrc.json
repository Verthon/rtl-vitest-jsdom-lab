{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "vitest", "promise", "unicorn", "jsx-a11y"],
  "jsPlugins": ["eslint-plugin-testing-library"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          { "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType"] }
        ],
        "vitest/no-conditional-expect": "error",
        "vitest/no-identical-title": "error",
        "vitest/no-standalone-expect": "error",
        "vitest/valid-describe-callback": "error",
        "vitest/valid-expect": "error",
        "vitest/valid-expect-in-promise": "error",
        "vitest/valid-title": "error",
        "vitest/require-local-test-context-for-concurrent-snapshots": "error",
        "vitest/no-focused-tests": "error",
        "vitest/no-commented-out-tests": "error",
        "vitest/require-awaited-expect-poll": "error",

        "vitest/consistent-test-it": ["error", { "fn": "test", "withinDescribe": "it" }],
        "vitest/prefer-to-be": "error",
        "vitest/prefer-to-have-length": "error",
        "vitest/prefer-to-contain": "error",
        "vitest/prefer-equality-matcher": "error",
        "vitest/prefer-comparison-matcher": "error",
        "vitest/prefer-to-be-object": "error",
        "vitest/no-alias-methods": "error",
        "vitest/prefer-called-with": "error",
        "vitest/prefer-spy-on": "error",
        "vitest/prefer-mock-promise-shorthand": "error",
        "vitest/prefer-mock-return-shorthand": "error",

        "vitest/prefer-strict-equal": "warn",
        "vitest/prefer-lowercase-title": "warn",
        "vitest/require-top-level-describe": "warn",
        "vitest/max-nested-describe": ["warn", { "max": 3 }],
        "vitest/no-large-snapshots": ["warn", { "maxSize": 50, "inlineMaxSize": 20 }],
        "vitest/prefer-each": "warn",
        "vitest/no-conditional-in-test": "warn",
        "vitest/require-hook": "warn",
        "vitest/prefer-hooks-on-top": "warn",
        "vitest/prefer-hooks-in-order": "warn",
        "vitest/consistent-test-filename": [
          "warn",
          {
            "pattern": ".*\\.spec\\.[tj]sx?$",
            "allTestPattern": ".*\\.(test|spec)\\.[tj]sx?$"
          }
        ]
      }
    }
  ]
}
